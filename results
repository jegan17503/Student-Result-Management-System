# MAIN PROGRAM
# ============================================================

print("=" * 70)
print("                 JAIN UNIVERSITY")
print("        STUDENT RESULT MANAGEMENT SYSTEM")
print("=" * 70)

name = input("Enter Student Name : ")
student_id = input("Enter Student ID   : ")

subjects = {}

number_of_subjects = int(
    input("Enter Number of Subjects : ")
)

for i in range(number_of_subjects):

    print("\nSubject", i + 1)

    subject_name = input("Enter Subject Name : ")

    # Internal Marks out of 70
    while True:

        internal = float(
            input("Enter Internal Marks (0-70) : ")
        )

        if 0 <= internal <= 70:
            break

        print("Invalid marks! Enter marks between 0 and 70.")

    # External Marks out of 30
    while True:

        external = float(
            input("Enter External Marks (0-30) : ")
        )

        if 0 <= external <= 30:
            break

        print("Invalid marks! Enter marks between 0 and 30.")

    subjects[subject_name] = {
        "internal": internal,
        "external": external
    }


# Create student result object
student = StudentResult(
    name,
    student_id,
    subjects
)

# Calculate and display result
student.calculate_result()